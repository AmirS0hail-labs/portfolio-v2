# Canonical URL (metadata, sitemap, robots, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://amir-portfolio.vercel.app

# Umami Cloud — set on Vercel Production only (never Preview or local).
# Dashboard: https://cloud.umami.is → website settings → Website ID
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Optional. Defaults to https://cloud.umami.is/script.js
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
